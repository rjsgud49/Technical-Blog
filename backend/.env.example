# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# MySQL (Windows setup.bat 기본값)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=react_structure
DB_SYNC=true

# JWT — 32자 이상 랜덤 문자열 (소스/깃에 실제 값 커밋 금지)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seed admin — backend/.env 에만 실제 값 기입 (비밀번호는 절대 커밋하지 말 것)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=rjsgud
